# Compile configurations
# Column description (columns are separated by semicolon):
# (1) Identifier for compile configuration (consisting of letters)
# (2) Compile options
NOOPT;-std=c++20 -DPOPCOUNT_TL -O3 -g -funroll-loops -fomit-frame-pointer -ffast-math
NOSSE;-std=c++20 -O3 -g -funroll-loops -fomit-frame-pointer -ffast-math
SSE;-std=c++20 -msse4.2 -O3 -g -funroll-loops -fomit-frame-pointer -ffast-math
HP;-std=c++20 -DUSE_HP -msse4.2 -O3 -g -funroll-loops -fomit-frame-pointer -ffast-math
O1;-std=c++20 -O1
O0;-std=c++20 -O0
